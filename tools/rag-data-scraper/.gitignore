# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/

# Virtual environments
.venv/
venv/
ENV/
env/

# Tests, coverage and runtime logs
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log

# Build and distribution artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Local configuration and secrets; examples remain versioned
.env
.env.*
!.env.example
!.env.*.example

# Runtime data: downloaded files, staging exports and SQLite sidecars
storage/raw/*
!storage/raw/.gitkeep
storage/ocr/*
!storage/ocr/.gitkeep
storage/staging/*
!storage/staging/.gitkeep
storage/state/*
!storage/state/.gitkeep

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
