{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StagingManifest",
  "type": "object",
  "required": [
    "job_id",
    "started_at",
    "completed_at",
    "total_observations",
    "total_chunk_sets",
    "total_chunks",
    "total_errors",
    "files"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "total_observations": { "type": "integer", "minimum": 0 },
    "total_chunk_sets": { "type": "integer", "minimum": 0 },
    "total_chunks": { "type": "integer", "minimum": 0 },
    "total_errors": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "object",
      "required": ["observations_file", "chunk_sets_file", "chunks_file", "errors_file"],
      "properties": {
        "observations_file": { "type": "string" },
        "chunk_sets_file": { "type": "string" },
        "chunks_file": { "type": "string" },
        "errors_file": { "type": "string" }
      }
    }
  }
}
