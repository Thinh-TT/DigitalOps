{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrawlerError",
  "type": "object",
  "required": [
    "error_id",
    "job_id",
    "source_id",
    "url",
    "stage",
    "error_type",
    "message",
    "timestamp"
  ],
  "properties": {
    "error_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string" },
    "source_id": { "type": "string" },
    "url": { "type": "string" },
    "stage": {
      "type": "string",
      "enum": ["fetch", "extract", "clean", "metadata", "chunk"]
    },
    "error_type": { "type": "string" },
    "message": { "type": "string" },
    "stack_trace": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
