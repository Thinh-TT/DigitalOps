# Copy this file to .env in this folder before running the API locally.
# Jwt__SigningKey must be at least 32 UTF-8 bytes.

ConnectionStrings__DigitalOps=Host=localhost;Port=5432;Database=DigitalOps;Username=postgres;Password=CHANGE_ME
Jwt__Issuer=DigitalOps.API
Jwt__Audience=DigitalOps.Web
Jwt__SigningKey=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenLifetimeMinutes=480

# Enable only while provisioning the first Administrator. Disable after a
# successful bootstrap. Never commit a real temporary password.
IdentityBootstrap__Enabled=false
IdentityBootstrap__UserName=admin
IdentityBootstrap__Email=admin@example.local
IdentityBootstrap__TemporaryPassword=CHANGE_ME_TO_A_TEMPORARY_PASSWORD
IdentityBootstrap__FullName=Quản trị viên hệ thống
IdentityBootstrap__Position=
IdentityBootstrap__Department=
IdentityBootstrap__Phone=
