# Development-only profile: OpenAI-compatible External chat provider.
# Use synthetic/redacted data only. Copy this file to .env in this folder,
# replace the database/JWT placeholders and set a real provider API key.

ConnectionStrings__DigitalOps=Host=localhost;Port=5432;Database=DigitalOps;Username=postgres;Password=CHANGE_ME
Jwt__Issuer=DigitalOps.API
Jwt__Audience=DigitalOps.Web
Jwt__SigningKey=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenLifetimeMinutes=480

# Optional member import limits. Defaults: 10 MiB, 10,000 rows and 100 MiB
# expanded XLSX content.
MemberImport__MaxFileSizeBytes=10485760
MemberImport__MaxRows=10000
MemberImport__MaxExpandedWorkbookBytes=104857600

# Incoming attachment storage. Keep this directory outside the web root and
# persist/back it up separately in deployed environments. Default max: 10 MiB.
AttachmentStorage__RootPath=App_Data/attachments
AttachmentStorage__MaxFileSizeBytes=10485760

# Reminder Worker defaults: enabled, every 15 minutes, 3 calendar days before
# deadline, using Vietnam time. IANA and Windows timezone IDs are supported.
ReminderWorker__Enabled=true
ReminderWorker__RunIntervalMinutes=15
ReminderWorker__BeforeDeadlineDays=3
ReminderWorker__TimeZoneId=Asia/Ho_Chi_Minh

# Enable only while provisioning the first Administrator. Disable after a
# successful bootstrap. Never commit a real temporary password.
IdentityBootstrap__Enabled=false
IdentityBootstrap__UserName=admin
IdentityBootstrap__Email=admin@example.local
IdentityBootstrap__TemporaryPassword=CHANGE_ME_TO_A_TEMPORARY_PASSWORD
IdentityBootstrap__FullName=Quản trị viên hệ thống
IdentityBootstrap__Position=
IdentityBootstrap__Department=
IdentityBootstrap__Phone=

# Optional local/demo seed for the seven document types and templates. Keep
# disabled in production and disable it again after the first successful run.
DocumentCatalogSeed__Enabled=false

# External changes only the LLM chat generation. Use HTTPS and a provider that
# supports strict JSON Schema structured outputs.
Ai__Provider=External
Ai__AutomaticFallback=false
Ai__ContextTokens=8192
Ai__TimeoutSeconds=60
Ai__AssignmentMaxOutputTokens=256
Ai__ReviewMaxOutputTokens=768
Ai__DraftMaxOutputTokens=1024
Ai__External__BaseUrl=https://provider.example/v1
Ai__External__ChatCompletionsPath=/chat/completions
Ai__External__Model=REPLACE_WITH_PROVIDER_MODEL
Ai__External__ApiKey=
Ai__External__SupportsStructuredOutputs=true

# Retrieval remains comparable with the approved local baseline. Embedding and
# Qdrant stay local; the Ollama service must be available on this development
# machine even when chat generation uses External.
Ai__Ollama__BaseUrl=http://127.0.0.1:11434
Ai__Ollama__LlmModel=qwen3:4b-instruct-2507-q4_K_M
Ai__Ollama__LlmDigest=0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0
Ai__Embedding__Provider=Ollama
Ai__Embedding__Model=qwen3-embedding:0.6b
Ai__Embedding__Digest=ac6da0dfba84a81fdbfbaf330198c33cd77c4cdfc53e8bc50eb581914a15621d
Ai__Embedding__Dimensions=1024
